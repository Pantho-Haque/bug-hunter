{
  "name": "@codequest/code-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@codequest/content": "workspace:*",
    "@codequest/domain": "workspace:*",
    "@codequest/simulation": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^2.1.2"
  }
}
