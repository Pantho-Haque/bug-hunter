{
  "name": "codequest-3d",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @codequest/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @codequest/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "lint": "pnpm -r lint && node scripts/check-package-boundaries.mjs",
    "hostile-check": "node scripts/hostile-code-harness.mjs",
    "perf-check": "node scripts/performance-harness.mjs",
    "copy-check": "node scripts/copy-and-access-audit.mjs",
    "progression-check": "node scripts/progression-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "playwright": "1.49.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.2"
  }
}
